<?xml version="1.0" encoding="utf-8"?>
<!--
  PayChat Android network security policy — DEBUG VARIANT ONLY.

  Release builds use app/src/main/res/xml/network_security_config.xml, which
  refuses all cleartext traffic. This override exists purely so a developer can
  point the wrapper at a locally running API server (Android emulator loopback).

  It permits cleartext ONLY for the emulator host aliases. It is never packaged
  into a release build because the debug source set does not contribute to the
  release variant.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Allows a locally installed development CA in debug builds only. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
