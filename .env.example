# ---- PayChat configuration. NEVER commit real values. ----
PAYCHAT_ENV=development              # development | test | production
PORT=4000
DATABASE_PATH=.data/paychat.db       # Postgres DSN in production (see db/postgres)

# Secrets: required in production, the app refuses to boot without them.
JWT_SECRET=                          # >= 32 bytes, from a secret manager
TOKEN_ENCRYPTION_KEY=                # base64, 32 bytes — encrypts provider tokens at rest
INTERNAL_JOB_TOKEN=                  # protects /api/internal/* (reconciliation)

# WebAuthn (biometric confirmation) — must match the origin users load the app from
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
PAYCHAT_WEBHOOK_BASE_URL=http://localhost:4000/api/webhooks

# Risk rules
RISK_STEP_UP_AMOUNT_MINOR=50000      # P500.00
RISK_VELOCITY_MAX=5
RISK_NEW_DEVICE_HOURS=24

# Payment providers — a rail becomes available ONLY when its credentials are set.
# Nothing is simulated in production; unconfigured rails are reported as unavailable.
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=

MYZAKA_BASE_URL=
MYZAKA_CLIENT_ID=
MYZAKA_CLIENT_SECRET=
MYZAKA_WEBHOOK_SECRET=

SMEGA_BASE_URL=
SMEGA_CLIENT_ID=
SMEGA_CLIENT_SECRET=
SMEGA_WEBHOOK_SECRET=

BANK_API_BASE_URL=
BANK_API_CLIENT_ID=
BANK_API_CLIENT_SECRET=
BANK_API_WEBHOOK_SECRET=

CARD_API_BASE_URL=
CARD_API_CLIENT_ID=
CARD_API_CLIENT_SECRET=
CARD_API_WEBHOOK_SECRET=

# ---- Redis (optional, production-grade multi-node deployments only) ----
# Leave unset for local development: the app then uses in-process rate limiting and locking.
# In production this MUST be a rediss:// (TLS) URL with AUTH; plain redis:// is refused.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1500

# ---- Provider registry (configuration, not code) ----
# JSON array of provider definitions. Merged over the built-in defaults by id; database rows
# (payment_providers) win over both. Adding a provider needs no code change.
PAYCHAT_PROVIDERS=
# Comma-separated provider ids that must never be used in this deployment (kill switch).
PAYCHAT_PROVIDER_DISABLE=
# Set to 1 to ignore the built-in defaults entirely and configure every provider here/in the DB.
PAYCHAT_PROVIDERS_NO_DEFAULTS=

# ---- Development / test only ----
PAYCHAT_DISABLE_SANDBOX=             # set to 1 to hide the simulated rail outside production
PAYCHAT_SANDBOX_SCENARIO=success     # success | processing | pending | failure_insufficient |
                                     # failure_invalid_recipient | timeout | unavailable
SANDBOX_WEBHOOK_SECRET=              # dev/test signature secret for the simulated rail

# ---- Verification commands ----
# npm run verify              typecheck + lint + tests + build
# npm run verify:rls          Postgres row-level security (needs PG_ADMIN_URL)
# npm run verify:migrations   migration discovery in clean environments
# npm run verify:secrets      credential / secret scan
# REDIS_URL=... npm run verify:redis   Redis-backed rate limiting, locking and caching
